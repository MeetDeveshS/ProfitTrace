# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# NEXT_PUBLIC_SITE_URL: Canonical base URL for production deployment
NEXT_PUBLIC_SITE_URL="https://profittrace.app"

# DATABASE_URL: PostgreSQL database connection string for Prisma ORM
DATABASE_URL="postgresql://postgres:password@localhost:5432/profittrace?schema=public"

# PORT: Server listening port
PORT=3000
