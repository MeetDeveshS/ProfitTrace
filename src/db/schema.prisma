// ProfitTrace Multi-Tenant Database Schema
// Provider: PostgreSQL via Prisma ORM

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  ADMIN
  FINANCE
  MANAGER
  ANALYST
  VIEWER
}

enum BusinessType {
  FUEL_STATION
  RETAIL
  RESTAURANT
  MANUFACTURING
  ECOMMERCE
  SERVICES
  DISTRIBUTION
}

enum BusinessScale {
  SMALL
  MEDIUM
  LARGE
}

enum EntityStatus {
  HEALTHY
  REVIEW
  LEAK_DETECTED
}

enum SeverityLevel {
  HIGH
  MEDIUM
  LOW
}

model Organization {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  users       User[]
  businesses  Business[]
  scenarios   Scenario[]
  reports     Report[]

  @@map("organizations")
}

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  passwordHash   String
  fullName       String
  role           Role          @default(ANALYST)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
  @@map("users")
}

model Business {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  scale          BusinessScale @default(MEDIUM)
  type           BusinessType  @default(RETAIL)
  currency       String        @default("INR")
  currencySymbol String        @default("₹")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  locations      Location[]
  products       Product[]
  expenses       Expense[]
  customers      Customer[]
  insights       Insight[]
  transactions   Transaction[]
  reports        Report[]

  @@index([organizationId])
  @@map("businesses")
}

model Location {
  id              String         @id @default(uuid())
  businessId      String
  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String
  code            String
  city            String
  managerName     String?
  status          EntityStatus   @default(HEALTHY)
  varianceNote    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  transactions    Transaction[]
  inventory       Inventory[]
  expenses        Expense[]

  @@unique([businessId, code])
  @@index([businessId])
  @@map("locations")
}

model Product {
  id                 String         @id @default(uuid())
  businessId         String
  business           Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sku                String
  name               String
  category           String
  unit               String         @default("Units")
  unitSellingPrice   Decimal        @db.Decimal(12, 2)
  unitCost           Decimal        @db.Decimal(12, 2)
  status             EntityStatus   @default(HEALTHY)
  varianceNote       String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  transactions       Transaction[]
  inventory          Inventory[]

  @@unique([businessId, sku])
  @@index([businessId])
  @@map("products")
}

model Transaction {
  id             String      @id @default(uuid())
  businessId     String
  business       Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  locationId     String
  location       Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  timestamp      DateTime    @default(now())
  quantity       Decimal     @db.Decimal(12, 2)
  unitPrice      Decimal     @db.Decimal(12, 2)
  totalRevenue   Decimal     @db.Decimal(14, 2)
  totalCost      Decimal     @db.Decimal(14, 2)
  grossProfit    Decimal     @db.Decimal(14, 2)
  discountAmount Decimal     @default(0) @db.Decimal(12, 2)
  paymentMethod  String      @default("CASH")

  @@index([businessId, timestamp])
  @@index([locationId])
  @@index([productId])
  @@map("transactions")
}

model Expense {
  id             String      @id @default(uuid())
  businessId     String
  business       Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  locationId     String?
  location       Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  category       String
  description    String
  amount         Decimal     @db.Decimal(14, 2)
  periodDate     DateTime
  isLeakRisk     Boolean     @default(false)
  createdAt      DateTime    @default(now())

  @@index([businessId, periodDate])
  @@map("expenses")
}

model Inventory {
  id             String      @id @default(uuid())
  productId      String
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId     String
  location       Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  quantityOnHand Decimal     @db.Decimal(12, 2)
  unitCost       Decimal     @db.Decimal(12, 2)
  turnoverDays   Decimal     @db.Decimal(8, 1)
  reorderLevel   Decimal?    @db.Decimal(12, 2)
  lastUpdated    DateTime    @updatedAt

  @@unique([productId, locationId])
  @@map("inventory")
}

model Customer {
  id             String        @id @default(uuid())
  businessId     String
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name           String
  customerType   String        @default("RETAIL") // FLEET, B2B, RETAIL
  creditTerms    Int           @default(0) // Days
  creditLimit    Decimal?      @db.Decimal(14, 2)
  totalSpend     Decimal       @default(0) @db.Decimal(14, 2)
  transactions   Transaction[]
  createdAt      DateTime      @default(now())

  @@index([businessId])
  @@map("customers")
}

model Insight {
  id                     String        @id @default(uuid())
  businessId             String
  business               Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title                  String
  category               String
  severity               SeverityLevel @default(MEDIUM)
  whatHappened           String
  possibleDrivers        String[]
  dataBehindObservation  String
  suggestedInvestigation String[]
  affectedEntityName     String
  createdAt              DateTime      @default(now())

  @@index([businessId])
  @@map("insights")
}

model Scenario {
  id                     String        @id @default(uuid())
  organizationId         String
  organization           Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title                  String
  baselineValues         Json
  proposedValues         Json
  projectedOutcomes      Json
  createdAt              DateTime      @default(now())

  @@index([organizationId])
  @@map("scenarios")
}

model Report {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessId     String?
  business       Business?     @relation(fields: [businessId], references: [id], onDelete: SetNull)
  title          String
  reportType     String
  periodRange    String
  fileFormat     String        @default("CSV")
  generatedAt    DateTime      @default(now())

  @@index([organizationId])
  @@map("reports")
}
